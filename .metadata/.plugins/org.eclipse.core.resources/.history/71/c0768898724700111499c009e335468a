import java.util.List;

class Emp implements Comparable<Emp>{
	String name;
	int id;
	double sal;
	
	
	public Emp(String name, int id, double sal) {
		super();
		this.name = name;
		this.id = id;
		this.sal = sal;
	}


	@Override
	public String toString() {
		return "Emp [name=" + name + ", id=" + id + ", sal=" + sal + "]";
	}


	@Override
	public int compareTo(Emp o) {
		
		if(this.id< o.id) {
			return -1;
		}
		else if (this.id>o.id) {
			return 1;
			
		}
		return 0;
	}
	
}
