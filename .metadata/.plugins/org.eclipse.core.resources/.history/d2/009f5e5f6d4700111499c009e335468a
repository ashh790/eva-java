package q15;

class Salary{
	int id;
	String name;
	double salary;
	public Salary(int id, String name, double salary) {
		super();
		this.id = id;
		this.name = name;
		this.salary = salary;
	}
	@Override
	public String toString() {
		return "Salary [id=" + id + ", name=" + name + ", salary=" + salary + "]";
	}
	
	
}

public class Main {

	public static void main(String[] args) {
		Salary salary = new Salary(101, "Ashraf",25000);
		System.out.println(salary);
	}

}
